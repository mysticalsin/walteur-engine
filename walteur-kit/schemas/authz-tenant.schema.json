{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WALTEUR AuthZ Tenant Proof",
  "description": "Machine-checkable authorization and tenant-isolation proof for deny-by-default access control, role and permission matrices, session and token policy, audit logging, negative tests, admin boundaries, and cross-tenant denial.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_id",
    "run_date",
    "build_class",
    "risk_tier",
    "verdict",
    "applicability",
    "model",
    "controls",
    "tests",
    "tenant_isolation",
    "evidence_refs",
    "signoff"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "proof_id": { "type": "string", "minLength": 1 },
    "run_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "build_class": { "type": "string", "minLength": 1 },
    "risk_tier": { "type": "string", "minLength": 1 },
    "verdict": { "const": "PASS" },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authn_surface", "authz_surface", "tenant_surface", "external_users"],
      "properties": {
        "authn_surface": { "type": "boolean" },
        "authz_surface": { "const": true },
        "tenant_surface": { "type": "boolean" },
        "external_users": { "type": "boolean" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authn_provider", "authz_model", "default_decision", "tenant_key"],
      "properties": {
        "authn_provider": { "type": "string", "minLength": 1 },
        "authz_model": { "type": "string", "enum": ["rbac", "abac", "pbac", "custom"] },
        "default_decision": { "const": "deny" },
        "tenant_key": { "type": "string", "minLength": 1 }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_permission_matrix_ref",
        "fail_closed_ref",
        "least_privilege_ref",
        "session_policy_ref",
        "token_policy_ref",
        "admin_boundary_ref",
        "audit_log_ref"
      ],
      "properties": {
        "role_permission_matrix_ref": { "$ref": "#/definitions/ref" },
        "fail_closed_ref": { "$ref": "#/definitions/ref" },
        "least_privilege_ref": { "$ref": "#/definitions/ref" },
        "session_policy_ref": { "$ref": "#/definitions/ref" },
        "token_policy_ref": { "$ref": "#/definitions/ref" },
        "admin_boundary_ref": { "$ref": "#/definitions/ref" },
        "audit_log_ref": { "$ref": "#/definitions/ref" }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive_authz_ref",
        "negative_authz_ref",
        "anonymous_denial_ref",
        "privilege_escalation_ref",
        "regression_command_ref"
      ],
      "properties": {
        "positive_authz_ref": { "$ref": "#/definitions/ref" },
        "negative_authz_ref": { "$ref": "#/definitions/ref" },
        "anonymous_denial_ref": { "$ref": "#/definitions/ref" },
        "privilege_escalation_ref": { "$ref": "#/definitions/ref" },
        "regression_command_ref": { "$ref": "#/definitions/ref" }
      }
    },
    "tenant_isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "tenant_key_ref",
        "rls_or_policy_ref",
        "cross_tenant_denial_ref",
        "isolation_evidence_ref"
      ],
      "properties": {
        "required": { "type": "boolean" },
        "tenant_key_ref": { "$ref": "#/definitions/ref" },
        "rls_or_policy_ref": { "$ref": "#/definitions/ref" },
        "cross_tenant_denial_ref": { "$ref": "#/definitions/ref" },
        "isolation_evidence_ref": { "$ref": "#/definitions/ref" }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/ref" }
    },
    "signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "owner", "signoff_ref"],
      "properties": {
        "required": { "const": true },
        "owner": { "type": "string", "minLength": 1 },
        "signoff_ref": { "$ref": "#/definitions/ref" }
      }
    }
  },
  "definitions": {
    "ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
