{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walteur.local/schemas/selftest-report.schema.json",
  "title": "WALTEUR Selftest Report",
  "description": "Machine-readable aggregate selftest proof written by walteur-kit/selftest.sh.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict",
    "ts",
    "summary",
    "counts",
    "skip_reasons"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL"]
    },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "summary": {
      "type": "string",
      "enum": [
        "ALL_GREEN",
        "ALL_PRESENT_CHECKS_GREEN",
        "SELFTEST_FAILED",
        "SELFTEST_REPORT_INVALID"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "skipped"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "skip_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
