{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walteur.local/schemas/source-manifest.schema.json",
  "title": "WALTEUR Source Manifest",
  "description": "Pinned upstream sources checked by walteur-kit/self-heal.sh and routed during WALTEUR planning.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "last_verified", "ttl_hours", "router_contract", "sources"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "manifest_id": { "type": "string", "minLength": 1 },
    "last_verified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "ttl_hours": { "type": "integer", "minimum": 1, "maximum": 168 },
    "router_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_phase_rule", "promotion_rule", "security_rule"],
      "properties": {
        "plan_phase_rule": { "type": "string", "minLength": 1 },
        "promotion_rule": { "type": "string", "minLength": 1 },
        "security_rule": { "type": "string", "minLength": 1 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repo_url",
          "branch",
          "pinned_head",
          "category",
          "priority",
          "adoption_mode",
          "use_when",
          "adopted_surface",
          "rationale",
          "promotion_policy",
          "risk_policy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "repo_url": {
            "type": "string",
            "pattern": "^https://github.com/[^/]+/[^/]+(\\.git)?$"
          },
          "branch": { "type": "string", "minLength": 1 },
          "pinned_head": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "pinned_tag": { "type": "string", "minLength": 1 },
          "pinned_tag_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "category": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "adoption_mode": { "type": "string", "minLength": 1 },
          "use_when": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "adopted_surface": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "promotion_policy": { "type": "string", "minLength": 1 },
          "risk_policy": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
