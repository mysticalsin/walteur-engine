{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walteur.local/schemas/gate-registry.schema.json",
  "title": "WALTEUR Gate Registry",
  "description": "Class and risk based registry of required WALTEUR gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "gates", "requirements"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "registry_id": { "type": "string", "minLength": 1 },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "hardness", "availability", "hook", "report", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stage": {
            "type": "string",
            "enum": ["intake", "discover", "plan", "build", "verify", "review", "ship", "reflect"]
          },
          "hardness": {
            "type": "string",
            "enum": ["hard", "detect_or_skip", "protocol", "manual"]
          },
          "availability": {
            "type": "string",
            "enum": ["spec", "canonical", "optional"]
          },
          "hook": { "type": "string", "minLength": 1 },
          "report": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "by_build_class", "by_risk_tier"],
      "properties": {
        "all": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "by_build_class": {
          "type": "object",
          "additionalProperties": false,
          "required": ["software", "workflow", "document", "data-ai", "cloud-iac", "mixed"],
          "properties": {
            "software": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "workflow": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "document": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "data-ai": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "cloud-iac": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "mixed": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "by_risk_tier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "medium", "high", "regulated"],
          "properties": {
            "low": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "medium": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "high": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "regulated": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
