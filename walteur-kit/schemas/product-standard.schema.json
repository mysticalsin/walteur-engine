{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walteur.local/schemas/product-standard.schema.json",
  "title": "WALTEUR Product Standard",
  "description": "Machine-checkable product/company completeness contract for user-facing, commercial, venture-grade, or full-product builds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "category",
    "date",
    "ambition",
    "evidence",
    "core_value_loop",
    "users",
    "product_surface",
    "business_model",
    "trust_and_ops",
    "launch_readiness",
    "out_of_scope",
    "signoff"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "product": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "ambition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "target_scale", "value_thesis", "differentiation_thesis"],
      "properties": {
        "stage": {
          "type": "string",
          "enum": ["internal_tool", "full_product", "commercial_product", "venture_grade"]
        },
        "target_scale": { "type": "string", "minLength": 1 },
        "value_thesis": { "type": "string", "minLength": 1 },
        "differentiation_thesis": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prd_ref", "benchmark_ref", "plan_ref"],
      "properties": {
        "prd_ref": { "type": "string", "minLength": 1 },
        "benchmark_ref": { "type": "string", "minLength": 1 },
        "plan_ref": { "type": "string", "minLength": 1 },
        "design_ref": { "type": "string", "minLength": 1 }
      }
    },
    "core_value_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pain", "promise", "activation_event", "habit_loop", "retention_mechanism", "north_star_metric"],
      "properties": {
        "pain": { "type": "string", "minLength": 1 },
        "promise": { "type": "string", "minLength": 1 },
        "activation_event": { "type": "string", "minLength": 1 },
        "habit_loop": { "type": "string", "minLength": 1 },
        "retention_mechanism": { "type": "string", "minLength": 1 },
        "north_star_metric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "target", "check"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 },
            "check": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "users": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "buyer", "admin", "support_operator"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "buyer": { "type": "string", "minLength": 1 },
        "admin": { "type": "string", "minLength": 1 },
        "support_operator": { "type": "string", "minLength": 1 }
      }
    },
    "product_surface": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "status", "ref"],
        "properties": {
          "area": {
            "type": "string",
            "enum": [
              "onboarding",
              "core_workflow",
              "data_model",
              "auth_permissions",
              "settings",
              "empty_loading_error_states",
              "analytics_telemetry",
              "admin_ops",
              "billing_or_value_exchange",
              "support_docs",
              "security_privacy",
              "release_ops"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["planned", "built", "verified", "out_of_scope"]
          },
          "ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "business_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_capture", "pricing_or_funding", "cost_drivers", "unit_economics_assumption", "expansion_path"],
      "properties": {
        "value_capture": { "type": "string", "minLength": 1 },
        "pricing_or_funding": { "type": "string", "minLength": 1 },
        "cost_drivers": { "type": "string", "minLength": 1 },
        "unit_economics_assumption": { "type": "string", "minLength": 1 },
        "expansion_path": { "type": "string", "minLength": 1 }
      }
    },
    "trust_and_ops": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authn_authz", "data_policy", "observability", "reliability_target", "support_model", "incident_response"],
      "properties": {
        "authn_authz": { "type": "string", "minLength": 1 },
        "data_policy": { "type": "string", "minLength": 1 },
        "observability": { "type": "string", "minLength": 1 },
        "reliability_target": { "type": "string", "minLength": 1 },
        "support_model": { "type": "string", "minLength": 1 },
        "incident_response": { "type": "string", "minLength": 1 }
      }
    },
    "launch_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_segment", "acquisition_or_distribution", "activation_metric", "feedback_channel", "release_plan"],
      "properties": {
        "first_segment": { "type": "string", "minLength": 1 },
        "acquisition_or_distribution": { "type": "string", "minLength": 1 },
        "activation_metric": { "type": "string", "minLength": 1 },
        "feedback_channel": { "type": "string", "minLength": 1 },
        "release_plan": { "type": "string", "minLength": 1 }
      }
    },
    "out_of_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "reason", "owner", "review_trigger"],
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "review_trigger": { "type": "string", "minLength": 1 }
        }
      }
    },
    "signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "status", "date"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["draft", "self_signed", "approved"] },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    }
  }
}
