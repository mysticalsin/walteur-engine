# Shell scripts MUST be LF. A CR before the newline makes bash parse $'{\r' and die
# on Linux/CI — the harness was entirely CRLF and every .sh failed `bash -n` on ubuntu
# runners. These rules make that unrepresentable regardless of contributor platform.
*.sh   text eol=lf
*.bash text eol=lf

# Everything else the gates read line-wise. jq, read -r and grep all mis-handle a
# stray CR; several gate fail-opens in this repo traced to exactly that.
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.rego  text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf

# Binary — never touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.mp3  binary
*.wav  binary
