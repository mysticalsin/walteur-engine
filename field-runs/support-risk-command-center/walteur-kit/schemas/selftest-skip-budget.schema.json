{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walteur.local/schemas/selftest-skip-budget.schema.json",
  "title": "WALTEUR Selftest Skip Budget",
  "description": "Allowlist and maximum budget for aggregate selftest skip reasons.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "budget_id",
    "updated_at",
    "policy",
    "max_skipped",
    "allowed_skip_reasons"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "budget_id": { "type": "string", "minLength": 1 },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "policy": { "type": "string", "minLength": 20 },
    "max_skipped": { "type": "integer", "minimum": 0 },
    "allowed_skip_reasons": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "surface", "why_allowed", "retirement_path"],
        "properties": {
          "reason": { "type": "string", "minLength": 1 },
          "surface": { "type": "string", "minLength": 1 },
          "why_allowed": { "type": "string", "minLength": 20 },
          "retirement_path": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
