{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walteur.local/schemas/scoreboard.schema.json",
  "title": "WALTEUR Scoreboard",
  "description": "Typed eight-dimension score contract for WALTEUR refine and ship decisions.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "target",
    "targets_locked",
    "composite",
    "dimensions",
    "ts"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "target": { "type": "number", "minimum": 0, "maximum": 10 },
    "targets_locked": { "type": "boolean", "const": true },
    "locked_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "locked_by": { "type": "string", "minLength": 1 },
    "composite": { "type": "number", "minimum": 0, "maximum": 10 },
    "refine_max": { "type": "integer", "minimum": 1 },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design",
        "infrastructure",
        "security",
        "ux_ui",
        "performance",
        "features",
        "data_architecture",
        "devex"
      ],
      "properties": {
        "design": { "$ref": "#/definitions/dimension_score" },
        "infrastructure": { "$ref": "#/definitions/dimension_score" },
        "security": { "$ref": "#/definitions/dimension_score" },
        "ux_ui": { "$ref": "#/definitions/dimension_score" },
        "performance": { "$ref": "#/definitions/dimension_score" },
        "features": { "$ref": "#/definitions/dimension_score" },
        "data_architecture": { "$ref": "#/definitions/dimension_score" },
        "devex": { "$ref": "#/definitions/dimension_score" }
      }
    },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "definitions": {
    "dimension_score": {
      "type": "object",
      "additionalProperties": true,
      "required": ["score", "floor", "rationale", "evidence_ref"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 10 },
        "floor": { "type": "number", "minimum": 0, "maximum": 10 },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
