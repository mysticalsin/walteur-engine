{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walteur.local/schemas/selftest-exceptions.schema.json",
  "title": "WALTEUR Selftest Exceptions",
  "description": "Auditable exceptions for selected spec hooks that do not yet expose --selftest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "updated_at", "policy", "exceptions"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "manifest_id": { "type": "string", "minLength": 1 },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "policy": { "type": "string", "minLength": 1 },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "hook",
          "exception_kind",
          "rationale",
          "replacement_proof",
          "next_action"
        ],
        "properties": {
          "gate_id": { "type": "string", "minLength": 1 },
          "hook": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+\\.sh$"
          },
          "exception_kind": {
            "type": "string",
            "enum": [
              "aggregate_assertion",
              "command_is_verification_surface",
              "legacy_runtime_gate_pending_selftest"
            ]
          },
          "rationale": { "type": "string", "minLength": 20 },
          "replacement_proof": { "type": "string", "minLength": 10 },
          "next_action": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
