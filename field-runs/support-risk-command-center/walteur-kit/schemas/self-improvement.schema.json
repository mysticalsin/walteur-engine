{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walteur.local/schemas/self-improvement.schema.json",
  "title": "WALTEUR Self Improvement",
  "description": "Compounding improvement contract for weakness mining, recent-source scouting, bounded proposals, regression validation, and memory updates.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "verdict",
    "trace_mining",
    "scout",
    "proposals",
    "regression",
    "compounding",
    "ts"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "verdict": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
    "trace_mining": {
      "type": "object",
      "additionalProperties": true,
      "required": ["trace_refs"],
      "properties": {
        "trace_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "failure_clusters": { "type": "array" }
      }
    },
    "scout": {
      "type": "object",
      "additionalProperties": true,
      "required": ["performed", "date", "sources", "candidates"],
      "properties": {
        "performed": { "type": "boolean", "const": true },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["kind", "name", "url", "captured_ref"],
            "properties": {
              "kind": { "type": "string", "enum": ["github_repo", "paper", "docs", "skill", "local"] },
              "name": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1 },
              "captured_ref": { "type": "string", "minLength": 1 }
            }
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name", "url", "license", "last_checked", "fit", "maintenance", "security", "decision", "evidence_ref"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1 },
              "license": { "type": "string", "minLength": 1 },
              "last_checked": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "fit": { "type": "string", "minLength": 1 },
              "maintenance": { "type": "string", "minLength": 1 },
              "security": { "type": "string", "minLength": 1 },
              "decision": { "type": "string", "enum": ["adopt", "defer", "reject"] },
              "evidence_ref": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "source", "change", "bounded", "status", "validation_ref"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "enum": ["weakness-mining", "github-scout", "retro", "manual"] },
          "change": { "type": "string", "minLength": 1 },
          "bounded": { "type": "boolean", "const": true },
          "status": { "type": "string", "enum": ["promoted", "rejected", "deferred", "no_change"] },
          "validation_ref": { "type": "string", "minLength": 1 },
          "rollback_ref": { "type": "string" },
          "delta": { "type": "object" }
        }
      }
    },
    "regression": {
      "type": "object",
      "additionalProperties": true,
      "required": ["baseline_ref", "current_ref", "regressions", "commands"],
      "properties": {
        "baseline_ref": { "type": "string", "minLength": 1 },
        "current_ref": { "type": "string", "minLength": 1 },
        "regressions": { "type": "integer", "minimum": 0 },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["command", "exit_code", "evidence_ref"],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "exit_code": { "type": "integer" },
              "evidence_ref": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "compounding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["memory_updates", "next_watch"],
      "properties": {
        "memory_updates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["lesson", "target_ref", "result_ref", "captured"],
            "properties": {
              "lesson": { "type": "string", "minLength": 1 },
              "target_ref": { "type": "string", "minLength": 1 },
              "result_ref": { "type": "string", "minLength": 1 },
              "captured": { "type": "boolean", "const": true }
            }
          }
        },
        "next_watch": { "type": "string", "minLength": 1 }
      }
    },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
