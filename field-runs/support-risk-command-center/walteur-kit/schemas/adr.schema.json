{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walteur.local/schemas/adr.schema.json",
  "title": "WALTEUR ADR Index",
  "description": "Typed index for resolved WALTEUR debate forks. Markdown ADR content is protocol-reviewed; this index makes ownership, status, rejected alternatives, and dissent mechanically checkable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "status",
          "decision",
          "owner",
          "date",
          "context",
          "rejected_alternatives",
          "dissent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{4}-[a-z0-9][a-z0-9-]*$"
          },
          "fork_id": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "pattern": "^(walteur-kit/adr/)?[0-9]{4}-[a-z0-9][a-z0-9-]*\\.md$"
          },
          "status": {
            "type": "string",
            "enum": ["accepted", "superseded", "rejected"]
          },
          "decision": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "context": { "type": "string", "minLength": 1 },
          "rejected_alternatives": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "dissent": { "type": "string", "minLength": 1 },
          "evidence_ref": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
